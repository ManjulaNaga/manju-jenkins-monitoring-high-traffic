# Copy to .env and fill in
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me
GIT_USER=your-git-user
GIT_TOKEN=your-git-token

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Public URL users reach Jenkins on
JENKINS_URL=http://localhost/

# ---- Traffic handling (Traefik) ----
RATE_LIMIT_AVG=50        # requests/second per client (average)
RATE_LIMIT_BURST=100     # short bursts allowed above the average
MAX_INFLIGHT=100         # max concurrent requests passed to Jenkins

# ---- Build capacity ----
AGENT_MAX=10             # max build agent containers at once

# Linux only: group id of /var/run/docker.sock  ->  stat -c '%g' /var/run/docker.sock
# DOCKER_GID=999
